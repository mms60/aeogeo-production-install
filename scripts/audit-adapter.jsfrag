// Tool scope revision: standard-only-v1. Only the 25-page scope is offered.
// This replaces only the synthetic engine and rendering data flow in the supplied interface.
let currentJob=null,lastProgress='',drawerReturnFocus=null,requestId=null,printState=null;
const PILLAR_NAMES={cq:'Content Quality',ai:'AI Readiness',tech:'Technical Basis',auth:'Authority & Trust'};
const text=(id,value)=>{if($(id))$(id).textContent=value;};
function showPanel(which){['input','progress','results'].forEach(x=>{$(x+'-panel').style.display=x===which?'block':'none';});}
function groupFor(p){const path=new URL(p.url).pathname;return /\bservices?\b/i.test(path)?'Services':/\b(blogs?|resources?|learn|guides?|faq)\b/i.test(path)?'Blog':/\babout\b/i.test(path)?'About':'Core';}
function badge(score){return score===null||score===undefined?'score-unavailable':score>=80?'score-great':score>=65?'score-good':score>=50?'score-fair':'score-poor';}
function statusName(m){return m.score===null?'Not evaluated':m.status==='pass'?'Pass':m.status==='review'?'Review':'Needs review';}
function allMetrics(){return report.pages[0].metrics.map(m=>{const values=report.pages.map(p=>p.metrics.find(x=>x.id===m.id)?.score).filter(v=>v!==null&&v!==undefined);return {...m,score:values.length?Math.round(values.reduce((a,b)=>a+b,0)/values.length):null,available:values.length};});}
function updateScopeUI(){const selected=document.querySelector('[name="audit-scope"]:checked')?.value||'25';for(const input of document.querySelectorAll('[name="audit-scope"]')){const n=input.value,card=$('scope-card-'+n);if(!card)continue;card.style.border=n===selected?'1px solid var(--color-royal-500)':'1px solid rgba(110,168,255,.2)';card.style.background=n===selected?'rgba(79,125,249,.15)':'transparent';}}
function setPresetDomain(domain){$('domain-input').value=domain;$('domain-input').focus();}
// Access to the account is independent of the allowance for NEW audits.
let auditAccess='unknown',auditBusy=false;
function auditAccessState(a){
 if(a.billingHold||(a.subscription?.billing_mode==='test'&&a.billingMode==='test'&&!a.sandboxCheckout))return 'hold';
 if(a.paidActive===true)return 'paid';
 if(typeof a.freeUsed!=='boolean')return 'unavailable';
 return a.freeUsed?'upgrade':'free';
}
function syncAuditButton(){const button=$('submit-btn');button.disabled=auditBusy||['loading','upgrade','hold','unavailable'].includes(auditAccess);}
function showAuditAccess(state,copy){
 auditAccess=state;const box=$('audit-access');box.hidden=false;text('audit-access-copy',copy);
 $('audit-choose-plan').hidden=state!=='upgrade';$('audit-retry-access').hidden=!['hold','unavailable'].includes(state);syncAuditButton();
}
function renderAuditAccess(a){
 const state=auditAccessState(a);
 const copy=state==='upgrade'?'Your free audit is complete. Your saved report is still available. Choose a plan to run more audits.':state==='paid'?(a.billingMode==='test'?'Stripe TEST audit access is active for this test account. This is not a live subscription.':'Your paid audit access is active. New audits use your server-verified page and domain allowance.'):state==='hold'?'New paid audits are paused for this account. You can still sign in and open saved reports. Check your account for billing details.':state==='free'?'One free audit is available for your account, up to 25 discoverable pages. No card is required.':'Your audit allowance could not be verified. Your sign-in has not ended. Check access again or open your account.';
 showAuditAccess(state,copy);return state;
}
async function checkAuditAccess(){
 showAuditAccess('loading','Checking your audit allowance...');
 try{return renderAuditAccess(await api('product-api'));}
 catch(e){showAuditAccess('unavailable',e.authRequired?'Sign in to check your audit allowance. Your account and saved reports remain available.':e.message);return 'unavailable';}
}
async function handleStartAudit(e){
 e?.preventDefault();if(auditBusy||!$('audit-form').reportValidity())return;
 auditBusy=true;syncAuditButton();msg('tool-message','');
 try{
  const scope=25,account=await api('product-api');
  const access=renderAuditAccess(account);
  if(access==='upgrade'){msg('tool-message','Your free audit is complete. Choose a plan below to run more audits. Your saved report is still available.');return;}
  if(!['free','paid'].includes(access))return;
  requestId||=crypto.randomUUID();
  const r=await api('start-audit',{body:{url:$('domain-input').value.trim(),pages:scope,requestId}});
  currentJob=r.id;lastProgress='';showPanel('progress');history.replaceState(null,'','?job='+encodeURIComponent(r.id));await pollJob(r.id);
 }catch(e){
  if(e.code==='subscription_required'){showAuditAccess('upgrade','Your free audit is complete. Your saved report is still available. Choose a plan to run more audits.');msg('tool-message','Choose a plan below to run another audit.');}
  else msg('tool-message',e.message,true);
 }finally{auditBusy=false;syncAuditButton();}
}
function appendLog(value){if(value===lastProgress)return;lastProgress=value;const d=document.createElement('div');d.style.marginTop='.35rem';d.style.color='var(--color-ice-200)';d.textContent=value;$('crawler-terminal').append(d);$('crawler-terminal').scrollTop=$('crawler-terminal').scrollHeight;}
function updateChecklist(id,label,color='var(--color-ice-300)'){const e=$(id)?.querySelector('.status-icon');if(e){e.textContent=label;e.style.color=color;}}
async function pollJob(id){clearTimeout(pollTimer);try{const job=await api('product-api',{query:'?action=report&id='+encodeURIComponent(id)});if(['completed','complete'].includes(job.status)){requestId=null;currentJob=null;renderReport(job.report,false);return;}if(job.status==='failed'){requestId=null;currentJob=null;throw Error(job.error_message||'The audit failed. Your unused reservation is restored.');}const p=job.progress||{};text('progress-title',job.status==='queued'?'Waiting for crawler pickup...':'Analyzing public website pages...');text('progress-subtext','Server-reported state: '+job.status+'. You can leave and reopen this job from your saved reports.');text('progress-step-text',p.analyzed?`${p.analyzed} of up to ${p.limit} pages analyzed`:'Waiting for a confirmed page count');const pct=p.limit?Math.min(99,Math.floor(p.analyzed/p.limit*100)):0;text('progress-pct',p.analyzed?'Scope: '+pct+'%':'Queued');$('progress-fill').style.width=pct+'%';appendLog(`[SERVER] ${job.status}${p.analyzed?' | analyzed='+p.analyzed+' | discovered='+p.discovered+' | scope='+p.limit:''}`);if(p.analyzed){updateChecklist('metric-check-1','✓','#34d399');updateChecklist('metric-check-2','◐');updateChecklist('metric-check-3','◐');updateChecklist('metric-check-4','◐');}pollTimer=setTimeout(()=>pollJob(id),5000);}catch(e){showPanel('input');msg('tool-message',e.message,true);}}
async function skipToResults(){if(currentJob){appendLog('[SYSTEM] Checking for a completed report. Incomplete findings are not fabricated.');await pollJob(currentJob);}else msg('tool-message','No current audit job. Start a permitted audit or open a saved report.');}
function renderReport(r,isSample=false){if(!r?.pages?.length||!Array.isArray(r.pages[0].metrics)||r.pages[0].metrics.length!==22)throw Error('This is not a compatible 22-metric report. Older reports remain downloadable from your account.');report=r;sample=isSample;clearTimeout(pollTimer);showPanel('results');$('sample-banner').hidden=!sample;msg('tool-message','');text('res-domain-name',new URL(r.target).hostname);text('res-page-count',r.pages.length+' pages');text('res-overall-score',scoreText(r.score));text('res-date-str',new Date(r.createdAt).toLocaleString());$('score-circle-svg').style.strokeDashoffset=264-(264*(r.score||0)/100);$('res-score-badge').className='score-badge '+badge(r.score);text('res-score-badge',r.score===null?'Not scored':r.score>=80?'Strong checklist score':r.score>=65?'Good checklist score':r.score>=50?'Checklist needs work':'Checklist needs review');for(const p of r.pillars){text('pillar-score-'+p.id,scoreText(p.score)+(p.score===null?'':'/100'));$('pillar-score-'+p.id).className='score-badge '+badge(p.score);$('pillar-bar-'+p.id).style.width=(p.score||0)+'%';}const scored=r.pages.reduce((n,p)=>n+p.metrics.filter(m=>m.score!==null).length,0)/r.pages.length;text('report-method-note',`${scored.toFixed(1)} of 22 dimensions scored per page on average. ${r.framework||''} ${(r.limitations||[]).join(' ')}${r.partial?' Scan scope, discovery or time limits mean this is not an exhaustive inventory.':''}`);text('growth-copy',`${r.fixes.length} review items across ${r.pages.length} pages. Use the simulator for hypothetical checklist changes; no AI citation lift is estimated.`);text('tab-action-count',r.fixes.length+' Fixes');text('tab-page-count',r.pages.length+' Pages');renderRoadmap();renderPagesTable();renderMetricMatrix();renderSimulator();switchTab('roadmap');window.scrollTo({top:100,behavior:'smooth'});}
function renderRoadmap(){const host=$('roadmap-list');host.innerHTML=report.fixes.length?report.fixes.map((f,i)=>{const m=report.pages.flatMap(p=>p.metrics).find(m=>m.id===f.id);return `<article class="glass-card roadmap-card" data-priority="${esc(f.priority.toLowerCase())}" style="border-radius:1rem;padding:1.5rem;position:relative;"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;margin-bottom:.75rem;"><div><div class="fix-meta"><span class="fix-priority ${esc(f.priority.toLowerCase())}">${esc(f.priority)} Priority</span><span style="color:var(--color-royal-400);font-weight:600;">${esc(PILLAR_NAMES[f.pillar])}</span><span style="color:var(--color-ice-300);">· Implementation: review required</span></div><h4 class="font-display" style="font-size:1.15rem;font-weight:700;color:#fff;">${i+1}. ${esc(f.title)}</h4></div><div style="text-align:right;"><span class="font-display" style="font-size:1.25rem;font-weight:800;color:var(--color-emerald-400);">${f.affected.length} pages</span><span style="display:block;font-size:.7rem;color:var(--color-ice-300);">Affected by this check</span></div></div><p style="font-size:.875rem;color:var(--color-ice-200);margin-bottom:1rem;line-height:1.55;">${esc(f.fix)}</p><div class="fix-steps"><div style="font-size:.8rem;font-weight:600;color:#fff;margin-bottom:.4rem;">How to Implement:</div><ol><li>Inspect the exact evidence on the affected pages below.</li><li>${esc(f.fix)}</li><li>Validate accuracy and accessibility, then recrawl to verify the change.</li></ol></div><details class="affected-links"><summary>View ${f.affected.length} affected page(s) and the observation method</summary><p style="margin:.5rem 0;">Method: ${esc(m?.method||'review')}. Priority is not a measured AI ranking impact.</p><ul>${f.affected.map(url=>'<li>'+link(url)+'</li>').join('')}</ul></details><div><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.35rem;"><span style="font-size:.75rem;font-weight:600;color:var(--color-ice-200);">Implementation Code Template</span><button type="button" data-copy="code-${esc(f.id)}" class="btn-secondary" style="font-size:.72rem;padding:.2rem .65rem;">Copy Code</button></div><pre id="code-${esc(f.id)}" class="code-template">${esc(template(f.id))}</pre><p style="font-size:12px;color:var(--color-ice-300);margin-top:.5rem;">Template only. Replace placeholders and verify real business facts before use.</p></div></article>`;}).join(''):'<div class="glass-card empty">No available checks below the review threshold. This does not prove actual AI visibility or complete website quality.</div>';}
function filterRoadmap(priority){document.querySelectorAll('#roadmap-list>[data-priority]').forEach(e=>e.hidden=priority!=='all'&&e.dataset.priority!==priority);document.querySelectorAll('[data-priority].btn-secondary').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.priority===priority)));}
function renderPagesTable(){const tbody=$('pages-table-body');tbody.innerHTML=report.pages.map((p,index)=>{const worst=[...p.metrics].filter(m=>m.score!==null&&m.score<70).sort((a,b)=>a.score-b.score)[0],group=groupFor(p);const scores=['cq','ai','tech','auth'].map(id=>p.pillars.find(x=>x.id===id)?.score??null);return `<tr data-group="${esc(group)}" style="border-bottom:1px solid rgba(110,168,255,.12);transition:background .2s;"><td style="padding:1rem 1.25rem;min-width:220px;"><div style="font-weight:600;color:#fff;font-size:.88rem;">${esc(p.title)}</div><div style="font-family:var(--font-mono);font-size:.75rem;color:var(--color-royal-400);margin-top:.15rem;overflow-wrap:anywhere;">${esc(p.path)}</div></td><td style="padding:1rem;"><span style="background:rgba(110,168,255,.12);color:var(--color-ice-200);padding:.2rem .55rem;border-radius:6px;font-size:.72rem;font-weight:500;">${esc(group)}</span></td><td style="padding:1rem;text-align:center;"><span class="score-badge ${badge(p.score)}" style="padding:.25rem .65rem;font-size:.82rem;">${scoreText(p.score)}</span></td><td style="padding:1rem;min-width:140px;"><div style="display:flex;gap:.35rem;align-items:center;font-size:.72rem;font-family:var(--font-display);">${scores.map((v,i)=>`<span title="${esc(Object.values(PILLAR_NAMES)[i])}">${scoreText(v)}</span>`).join('<span style="color:rgba(110,168,255,.3);">/</span>')}</div><div style="display:flex;gap:3px;height:4px;margin-top:.35rem;">${scores.map((v,i)=>`<div style="flex:1;background:${['#4f7df9','#6ea8ff','#34d399','#fbbf24'][i]};height:100%;border-radius:2px;opacity:${v===null?.15:v/100};"></div>`).join('')}</div></td><td style="padding:1rem;font-size:.78rem;color:var(--color-ice-300);min-width:180px;">${esc(worst?worst.name+': '+worst.evidence:'No scored checks below review threshold. Unknown checks still require separate evaluation.')}</td><td style="padding:1rem 1.25rem;text-align:right;"><button type="button" data-inspect="${index}" class="btn-secondary" style="font-size:.75rem;padding:.3rem .75rem;">Inspect</button></td></tr>`;}).join('');filterPagesTable();}
function filterPagesTable(){const query=$('page-search-input').value.toLowerCase(),group=$('group-filter-select').value;document.querySelectorAll('#pages-table-body tr').forEach(row=>{row.hidden=!(row.textContent.toLowerCase().includes(query)&&(group==='all'||row.dataset.group===group));});}
function renderMetricMatrix(){$('metric-grid-container').innerHTML=allMetrics().map(m=>`<article class="glass-card metric-card" style="border-radius:.85rem;padding:1.25rem;"><div class="metric-card-title" style="margin-bottom:.5rem;"><div><span style="font-size:.68rem;font-weight:700;color:var(--color-royal-400);text-transform:uppercase;">${esc(PILLAR_NAMES[m.pillar])} · within-pillar weight ${m.weight}</span><h4 class="font-display" style="font-size:.95rem;font-weight:700;color:#fff;margin-top:.15rem;">${esc(m.name)}</h4></div><span class="score-badge ${badge(m.score)}" style="font-size:.7rem;padding:.15rem .5rem;">${m.score===null?'N/A':scoreText(m.score)}</span></div><p style="font-size:.78rem;color:var(--color-ice-200);margin-bottom:.65rem;line-height:1.5;">${esc(m.fix)}</p><div style="font-size:.72rem;color:var(--color-ice-300);background:rgba(5,11,31,.6);padding:.4rem .65rem;border-radius:6px;"><span class="method-chip ${esc(m.method)}">${esc(m.method)}</span> ${m.available}/${report.pages.length} pages scored. ${m.score===null?'Excluded from scoring; not evaluated.':'Open a page to inspect the exact observation.'}</div></article>`).join('');}
function simulate(ids){return aggregate(report.pages.map(p=>({...p,metrics:p.metrics.map(m=>({...m,score:m.score!==null&&ids.has(m.id)?100:m.score}))})));}
function renderSimulator(){text('sim-current-score',scoreText(report.score));text('sim-projected-score',scoreText(report.score));const applicable=allMetrics().filter(m=>m.score!==null&&m.score<100);$('simulator-checklist').innerHTML=applicable.map(m=>{const delta=simulate(new Set([m.id]))-report.score;return `<label class="sim-label"><input type="checkbox" class="sim-check" value="${esc(m.id)}" /><div style="flex:1;"><div style="font-size:.85rem;font-weight:600;color:#fff;">${esc(m.name)}</div><div style="font-size:.75rem;color:var(--color-ice-300);">${esc(PILLAR_NAMES[m.pillar])} · Assume scored values reach 100</div></div><span style="font-size:.85rem;font-weight:700;color:var(--color-emerald-400);font-family:var(--font-display);">+${delta} pts</span></label>`;}).join('');}
function recalcSimulator(){const ids=new Set([...document.querySelectorAll('.sim-check:checked')].map(e=>e.value));text('sim-projected-score',scoreText(simulate(ids)));}
function selectAllSimulator(checked){document.querySelectorAll('.sim-check').forEach(e=>e.checked=checked);recalcSimulator();}
function switchTab(tab){document.querySelectorAll('.tab-btn').forEach(b=>{const active=b.dataset.tab===tab;b.classList.toggle('active',active);b.setAttribute('aria-selected',String(active));});document.querySelectorAll('.tab-pane').forEach(p=>p.style.display=p.id==='tab-content-'+tab?'block':'none');}
function openPageDrawer(index){const p=typeof index==='string'?report.pages.find(p=>p.path===index):report.pages[index];if(!p)return;drawerReturnFocus=document.activeElement;text('drawer-page-title',p.title);text('drawer-page-url',p.url);text('drawer-badge',`${p.metrics.filter(m=>m.score!==null).length}/22 SCORED · PAGE ANALYSIS`);for(const id of ['cq','ai','tech','auth'])text('drawer-'+id,scoreText(p.pillars.find(x=>x.id===id)?.score));$('drawer-findings-list').innerHTML=p.metrics.map(m=>`<article class="glass drawer-finding"><span style="color:${color(m.score)};" aria-hidden="true">●</span><div style="min-width:0;"><strong>${esc(m.name)}:</strong> <span class="method-chip ${esc(m.method)}">${esc(m.method)}</span><p>${esc(m.evidence)}</p><p><b>${m.score===null?'Not evaluated':scoreText(m.score)+'/100'}.</b> ${esc(m.fix)}</p></div></article>`).join('');const worst=[...p.metrics].filter(m=>m.score!==null&&m.score<70).sort((a,b)=>a.score-b.score)[0];text('drawer-code-block',worst?template(worst.id):'No lower-scoring check was selected. Review all evidence and unavailable dimensions before making changes.');$('page-drawer').classList.add('active');$('page-drawer').setAttribute('aria-hidden','false');document.body.style.overflow='hidden';$('drawer-panel').focus();}
function closeDrawer(e){if(e&&e.target!==e.currentTarget)return;$('page-drawer').classList.remove('active');$('page-drawer').setAttribute('aria-hidden','true');document.body.style.overflow='';drawerReturnFocus?.focus();}
async function copyCode(btn,id){try{await navigator.clipboard.writeText($(id).textContent);const old=btn.textContent;btn.textContent='Copied! ✓';setTimeout(()=>btn.textContent=old,1800);}catch{btn.textContent='Select and copy the snippet below';}}
function exportMarkdownBrief(){if(!report)return;const md=`# Complete Website GEO Audit: ${report.target}${sample?' (SAMPLE)':''}\n\nAnalyzed: ${report.createdAt}\nChecklist score: ${scoreText(report.score)}/100\nPages: ${report.pages.length}\n\n## Method and limitations\n${report.framework}\n${report.limitations.map(s=>'- '+s).join('\n')}\n\n## Four pillars\n${report.pillars.map(p=>'- '+p.name+' ('+p.weight+'%): '+scoreText(p.score)).join('\n')}\n\n## Prioritized action plan\n${report.fixes.map((f,i)=>`### ${i+1}. ${f.title}\nPriority: ${f.priority}; affected pages: ${f.affected.length}\n\n${f.fix}\n\n${f.affected.map(u=>'- '+u).join('\n')}\n\nTemplate only; verify facts and replace placeholders:\n\`\`\`\n${template(f.id)}\n\`\`\``).join('\n\n')}\n\n## Page evidence\n${report.pages.map(p=>`### ${p.title}\nURL: ${p.url}\nChecklist score: ${scoreText(p.score)}\n${p.metrics.map(m=>`- ${m.name} (${m.method}, ${scoreText(m.score)}): ${m.evidence}`).join('\n')}`).join('\n\n')}\n\nGenerated by aeogeosearch (https://aeogeosearch.com/).\n`;download(reportName()+'.md',md,'text/markdown');}
function exportCsvData(){if(!report)return;const cell=v=>'"'+String(v??'').replace(/"/g,'""').replace(/^(?=\s*[=+\-@]|[\t\r\n])/,"'")+'"';const rows=[['Sample','URL','Title','Section','Checklist Score','Content Quality','AI Readiness','Technical','Authority','Metric','Method','Metric Score','Status','Evidence','Recommendation'],...report.pages.flatMap(p=>p.metrics.map(m=>[sample,p.url,p.title,groupFor(p),p.score,...['cq','ai','tech','auth'].map(id=>p.pillars.find(x=>x.id===id)?.score),m.name,m.method,m.score,m.status,m.evidence,m.fix]))];download(reportName()+'.csv','\uFEFF'+rows.map(r=>r.map(cell).join(',')).join('\r\n'),'text/csv;charset=utf-8');}
function restartAudit(){clearTimeout(pollTimer);showPanel('input');msg('tool-message','New audits still use your normal server-verified allowance. Opening a saved report does not.');history.replaceState(null,'','/geo-audit/run/');requestId=null;currentJob=null;if(!window.AEOGEO_OFFLINE_REVIEW)checkAuditAccess();window.scrollTo({top:100,behavior:'smooth'});}
function showComparison(other){const row=(name,left,right)=>`<tr><th>${esc(name)}</th><td>${esc(left)}</td><td>${esc(right)}</td></tr>`;$('comparison-output').innerHTML=`<table class="comparison-table"><thead><tr><th>Readiness checklist</th><th>${esc(report.target)}</th><th>${esc(other.target)}</th></tr></thead><tbody>${row('Scanned pages',report.pages.length,other.pages.length)}${row('Checklist score',scoreText(report.score),scoreText(other.score))}${report.pillars.map(p=>row(p.name,scoreText(p.score),scoreText(other.pillars.find(x=>x.id===p.id)?.score))).join('')}</tbody></table>`;}
async function loadComparison(){try{if(sample){const response=await fetch('/assets/sample-comparison.json');showComparison(await response.json());text('comparison-message','Two fictional HTML fixtures processed by the real analyzer. No live competitor rankings were tested.');return;}const a=await api('product-api');const jobs=a.jobs.filter(j=>j.status==='completed');$('comparison-select').innerHTML='<option value="">Choose a completed report...</option>'+jobs.map(j=>`<option value="${esc(j.id)}">${esc(j.target_url)} · ${esc(new Date(j.created_at).toLocaleDateString())}</option>`).join('');$('comparison-select').hidden=false;text('comparison-message',jobs.length?'Only your own saved reports are listed. Scanning another website consumes your normal page/domain allowance.':'No completed reports to compare yet.');}catch(e){text('comparison-message',e.message);}}
async function loadSample(){const response=await fetch('/assets/sample-report.json',{cache:'no-store'});if(!response.ok)throw Error('The sample report could not load.');renderReport(await response.json(),true);}
async function initLiveStatus(){
 if(window.AEOGEO_OFFLINE_REVIEW){text('engine-status-text','Offline review');return;}
 try{
  const response=await fetch('/.netlify/functions/product-api?action=config',{cache:'no-store'});
  if(!response.ok){setSignInStatus(false,'Not connected');return;}await response.json();
  const cached=await getClient().auth.getSession();
  if(cached.error){if(authenticationFailed(cached.error))requireSignIn(true);else setSignInStatus(false,'Unable to verify sign-in');return;}
  if(!cached.data?.session){setSignInStatus(false);return;}
  text('engine-status-text','Checking sign-in…');
  const verified=await getClient().auth.getUser();
  if(verified.error){
   if(verified.error.status===401||verified.error.name==='AuthSessionMissingError'){requireSignIn(true);return;}
   setSignInStatus(false,'Unable to verify sign-in');return;
  }
  if(!verified.data?.user){requireSignIn(true);return;}
  if(authRecovery){setSignInStatus(false);return;}
  setSignInStatus(true,verified.data.user.email_confirmed_at?'Signed in':'Confirm your email');
  const route=new URLSearchParams(location.search);if(verified.data.user.email_confirmed_at&&!['sample','report','job'].some(k=>route.has(k)))await checkAuditAccess();
 }catch{setSignInStatus(false,authRecovery?'Sign-in required':'Unable to verify sign-in');}
}
$('tool-sign-in').addEventListener('click',rememberAuditDraft);$('audit-retry-access').onclick=checkAuditAccess;$('audit-form').addEventListener('submit',handleStartAudit);document.querySelectorAll('[name="audit-scope"]').forEach(e=>e.onchange=updateScopeUI);document.querySelectorAll('[data-preset]').forEach(b=>b.onclick=()=>setPresetDomain(b.dataset.preset));document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>switchTab(b.dataset.tab));document.querySelectorAll('[data-switch]').forEach(b=>b.onclick=()=>switchTab(b.dataset.switch));document.querySelectorAll('button[data-priority]').forEach(b=>b.onclick=()=>filterRoadmap(b.dataset.priority));$('page-search-input').oninput=filterPagesTable;$('group-filter-select').onchange=filterPagesTable;$('simulator-checklist').onchange=recalcSimulator;$('sim-all').onclick=()=>selectAllSimulator(true);$('sim-reset').onclick=()=>selectAllSimulator(false);$('export-md').onclick=exportMarkdownBrief;$('export-csv').onclick=exportCsvData;$('export-pdf').onclick=()=>window.print();$('restart-audit').onclick=restartAudit;$('check-report').onclick=skipToResults;$('open-sample').onclick=()=>loadSample().catch(e=>msg('tool-message',e.message,true));$('drawer-close').onclick=()=>closeDrawer();$('drawer-done').onclick=()=>closeDrawer();$('page-drawer').onclick=closeDrawer;$('drawer-copy-btn').onclick=()=>copyCode($('drawer-copy-btn'),'drawer-code-block');$('comparison-load').onclick=loadComparison;$('comparison-select').onchange=async()=>{const id=$('comparison-select').value;if(!id)return;try{const j=await api('product-api',{query:'?action=report&id='+encodeURIComponent(id)});showComparison(j.report);}catch(e){text('comparison-message',e.message);}};
$('results-panel').addEventListener('click',e=>{const inspect=e.target.closest('[data-inspect]'),copy=e.target.closest('[data-copy]');if(inspect)openPageDrawer(Number(inspect.dataset.inspect));if(copy)copyCode(copy,copy.dataset.copy);});
document.addEventListener('keydown',e=>{if(!$('page-drawer').classList.contains('active'))return;if(e.key==='Escape')closeDrawer();if(e.key==='Tab'){const items=[...$('drawer-panel').querySelectorAll('button,a[href],input,select,[tabindex="0"]')].filter(el=>!el.hidden&&!el.disabled);const first=items[0],last=items.at(-1);if(e.shiftKey&&(document.activeElement===first||document.activeElement===$('drawer-panel'))){e.preventDefault();last.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}});
window.addEventListener('beforeprint',()=>{if(!report)return;printState={details:[...document.querySelectorAll('details:not([open])')],hidden:[...document.querySelectorAll('#roadmap-list>[hidden],#pages-table-body>[hidden]')]};printState.details.forEach(e=>e.open=true);printState.hidden.forEach(e=>e.hidden=false);});window.addEventListener('afterprint',()=>{printState?.details.forEach(e=>e.open=false);printState?.hidden.forEach(e=>e.hidden=true);printState=null;});
Object.assign(window,{handleStartAudit,setPresetDomain,updateScopeUI,skipToResults,switchTab,filterRoadmap,filterPagesTable,openPageDrawer,closeDrawer,exportMarkdownBrief,exportCsvData,recalcSimulator,selectAllSimulator,restartAudit,copyDrawerCode:()=>copyCode($('drawer-copy-btn'),'drawer-code-block'),copySnippetText:copyCode});
restoreAuditDraft();updateScopeUI();initLiveStatus();const params=new URLSearchParams(location.search);if(window.AEOGEO_OFFLINE_REVIEW||params.has('sample'))loadSample().catch(e=>msg('tool-message',e.message,true));else if(params.has('report'))api('product-api',{query:'?action=report&id='+encodeURIComponent(params.get('report'))}).then(j=>renderReport(j.report)).catch(e=>msg('tool-message',e.message,true));else if(params.has('job')){currentJob=params.get('job');showPanel('progress');pollJob(currentJob);}
})();
