{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeogeo-search",
  "compatibility_date": "2026-11-17",
  "main": "worker/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.docx"],
      "fallthrough": true
    }
  ],

  "assets": {
    "directory": "./.cloudflare/site",
    "binding": "ASSETS",
    "run_worker_first": ["/.netlify/functions/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "kv_namespaces": [
    {
      "binding": "INDEXNOW_LEDGER",
      "id": "b21a96e588704f9787e6c579ccd450fb"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "aegeo-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "aegeo-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 2
      }
    ]
  },

  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
