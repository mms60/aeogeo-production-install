{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeogeo-search",
  "compatibility_date": "2026-11-17",
  "main": "worker/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.docx"],
      "fallthrough": true
    }
  ],

  "assets": {
    "directory": "./.cloudflare/site",
    "binding": "ASSETS",
    "run_worker_first": ["/.netlify/functions/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "kv_namespaces": [
    {
      "binding": "INDEXNOW_LEDGER",
      "id": "b21a96e588704f9787e6c579ccd450fb"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "aegeo-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "aegeo-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 2
      }
    ]
  },

  "secrets": {
    "required": [
    "ADVANCED_PLANS_READY",
    "BILLING_ADMIN_EMAILS",
    "BILLING_ENABLED",
    "BILLING_REVIEW_COMPLETE",
    "BILLING_TEST_EMAILS",
    "BILLING_TEST_ENABLED",
    "CONTENT_SERVICE_ENABLED",
    "CONTENT_SERVICE_SETUP_ENABLED",
    "GUEST_SERVICE_CHECKOUT_ENABLED",
    "LIVE_PAYMENTS_ENABLED",
    "MONTHLY_SERVICE_CHECKOUT_ENABLED",
    "MONTHLY_SERVICE_REVIEW_COMPLETE",
    "PLAN_LIMITS_APPROVED",
    "PUBLIC_SITE_URL",
    "SERVICE_CHECKOUT_ENABLED",
    "STRIPE_AI_VISIBILITY_MONTHLY_PRICE_ID",
    "STRIPE_PRICE_AGENCY_MONTH",
    "STRIPE_PRICE_AGENCY_YEAR",
    "STRIPE_PRICE_PROFESSIONAL_MONTH",
    "STRIPE_PRICE_PROFESSIONAL_YEAR",
    "STRIPE_PRICE_STARTER_MONTH",
    "STRIPE_PRICE_STARTER_YEAR",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "SUPABASE_ANON_KEY",
    "SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_URL"
    ]
  },

  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
